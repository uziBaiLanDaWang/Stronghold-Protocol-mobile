<?xml version="1.0" encoding="utf-8"?>
<!--
  The offline-solo shell: a single WebView activity around the static tree that tools/make-offline.mjs assembles,
  with a launcher screen that can also point the same WebView at a server for 1-4 player co-op.

  Offline is served straight out of the APK's assets by AssetInterceptor (see
  android/java/**/AssetInterceptor.java for why interception rather than file:// or a loopback HTTP server) and uses
  no network at all. The INTERNET permission below exists for the online mode only, where the client is loaded from
  the server exactly as a desktop browser would load it - which also keeps the two in step, since the server refuses
  a client whose PROTOCOL_VERSION does not match. usesCleartextTraffic is for the common case of a server on the
  local network (http://192.168.x.x:3000), the address npm start prints.

  Landscape only (css/devices.css:3 designs for phones in landscape and index.html shows a full-screen "请将设备横屏"
  overlay otherwise), and configChanges so a rotation or fold never restarts the activity mid-match.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.stronghold.offline"
    android:versionCode="3"
    android:versionName="0.1.4">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />

    <!-- Online (co-op) mode only: the offline mode serves the bundled assets through AssetInterceptor and never
         opens a socket. There is no user-visible prompt for this permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Touch input only; a gamepad/mouse is optional. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:largeHeap="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
